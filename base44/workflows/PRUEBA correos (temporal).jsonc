{
  "name": "PRUEBA correos (temporal)",
  "description": "Prueba puntual de los correos; se archiva despu\u00e9s",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 1 1 *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "mejoras": {
          "call": "invoke_backend_function",
          "then": "aprobada",
          "with": {
            "args": {},
            "function_name": "sendMejorasEmail"
          }
        }
      },
      {
        "aprobada": {
          "call": "invoke_backend_function",
          "then": "rechazada",
          "with": {
            "args": {
              "decision": "approved",
              "submission_id": "6adcb3fa5a6cb53ed34b46ea"
            },
            "function_name": "notifySubmissionDecision"
          }
        }
      },
      {
        "rechazada": {
          "call": "invoke_backend_function",
          "then": "contacto",
          "with": {
            "args": {
              "decision": "rejected",
              "submission_id": "6adcb3fa5a6cb53ed34b46eb"
            },
            "function_name": "notifySubmissionDecision"
          }
        }
      },
      {
        "contacto": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "message_id": "6adcb3fbc11227c430cd55ae",
              "reply": "Esto es una respuesta de prueba del sistema."
            },
            "function_name": "sendContactReply"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "prueba_correos",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}