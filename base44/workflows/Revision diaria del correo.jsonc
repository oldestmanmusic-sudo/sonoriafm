{
  "name": "Revision diaria del correo",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "revision_diaria_correo",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "revisa_correo": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reviewMarketingInbox",
            "args": {
              "days": 3
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Revisar rebotes y respuestas",
            "description": "Lee el Gmail, marca en la base de datos y en la hoja de Drive los correos que no funcionan, bajas, no interesados y respuestas"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 8 * * *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Cada d\u00eda a las 8:30 (Madrid) revisa el correo y marca en la hoja de Drive los contactos con correo inv\u00e1lido, bajas, no interesados y respuestas"
}