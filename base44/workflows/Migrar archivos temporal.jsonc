{
  "name": "Migrar archivos temporal",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 1 1 *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrar_archivos_temporal",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "migra": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "migrateExternalAssets",
            "args": {
              "limit": 4
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Copiar archivos de la otra app",
            "description": "Temporal: se borra al terminar la migraci\u00f3n"
          }
        }
      }
    ]
  }
}