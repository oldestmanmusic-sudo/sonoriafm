{
  "name": "Cierre semanal del TOP",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cierre_semanal_top",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "cierra_top": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "closeWeeklyTop",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Guardar TOP y reiniciar likes",
            "description": "Registra los puestos 1 a 3 en la web y en la hoja de Drive y pone los me gusta a cero"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 * * 1",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Cada noche de domingo a lunes (lunes 00:00, hora de Madrid) guarda el TOP 3 con fecha en \"Semanas en el TOP\" y reinicia los me gusta"
}