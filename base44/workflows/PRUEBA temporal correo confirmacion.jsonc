{
  "name": "PRUEBA temporal correo confirmacion",
  "description": "Prueba manual del correo de confirmaci\u00f3n, solo a la direcci\u00f3n del propietario. Se archiva al terminar.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 1 1 *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "envia_prueba": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "artist_name": "Prueba SONORIA FM",
              "email": "oldestmanmusic@gmail.com",
              "song_title": "PRUEBA del correo (no aprobar)"
            },
            "function_name": "welcomeArtist"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "prueba_temporal_correo",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}