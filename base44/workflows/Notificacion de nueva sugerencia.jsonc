{
  "name": "Notificaci\u00f3n de nueva sugerencia",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificacion_sugerencia",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "avisa_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewSuggestion",
            "args": {
              "suggestion_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email al administrador",
            "description": "Notificaci\u00f3n de sugerencia recibida"
          }
        }
      }
    ]
  },
  "description": "Cuando alguien env\u00eda una sugerencia en la web, avisa por email al administrador",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Suggestion"
    }
  }
}