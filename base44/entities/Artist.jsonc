{
  "name": "Artist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}