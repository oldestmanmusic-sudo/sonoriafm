{
  "name": "Submission",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "song_title": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "Pop latino",
        "Urbano/Reguetón",
        "Baladas",
        "Electrónica",
        "Otros idiomas",
        "Otros"
      ],
      "default": "Otros"
    },
    "audio_link": {
      "type": "string"
    },
    "audio_file_uri": {
      "type": "string"
    },
    "cover_file_uri": {
      "type": "string"
    },
    "artist_image_uri": {
      "type": "string"
    },
    "artist_image_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "artist_bio": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "lyrics": {
      "type": "string"
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false,
      "description": "El remitente aceptó los Términos y Condiciones (cesión de derechos, renuncia de reclamaciones y tratamiento de datos)."
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "changes_requested"
      ],
      "default": "pending"
    },
    "admin_note": {
      "type": "string"
    },
    "ai_opinion": {
      "type": "string"
    }
  },
  "required": [
    "artist_name",
    "email",
    "song_title",
    "confirmed"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}