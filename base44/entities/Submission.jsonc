{
  "name": "Submission",
  "type": "object",
  "properties": {
    "artist_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "song_title": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "description": "Género: los de siempre o uno añadido por los artistas.",
      "default": "Otros"
    },
    "genre_other": {
      "type": "string",
      "description": "G\u00e9nero escrito por el artista cuando elige Otros."
    },
    "audio_link": {
      "type": "string"
    },
    "audio_file_uri": {
      "type": "string"
    },
    "cover_file_uri": {
      "type": "string"
    },
    "artist_image_uri": {
      "type": "string"
    },
    "artist_image_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "artist_bio": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "lyrics": {
      "type": "string"
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false,
      "description": "El remitente acept\u00f3 los T\u00e9rminos y Condiciones (cesi\u00f3n de derechos, renuncia de reclamaciones y tratamiento de datos)."
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "changes_requested"
      ],
      "default": "pending"
    },
    "admin_note": {
      "type": "string"
    },
    "ai_opinion": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "Espa\u00f1ol",
        "Otros idiomas"
      ],
      "default": "Espa\u00f1ol",
      "description": "Idioma de la canci\u00f3n"
    }
  },
  "required": [
    "artist_name",
    "email",
    "song_title",
    "confirmed"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}