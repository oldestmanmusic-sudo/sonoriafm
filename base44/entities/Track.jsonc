{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "played_at": {
      "type": "string",
      "format": "date-time"
    },
    "genre": {
      "type": "string",
      "enum": [
        "Pop latino",
        "Urbano/Reguetón",
        "Baladas",
        "Electrónica",
        "Otros"
      ],
      "default": "Otros"
    },
    "duration": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "album": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "language": {
      "type": "string",
      "enum": [
        "Español",
        "Otros idiomas"
      ],
      "default": "Español",
      "description": "Idioma de la canción"
    }
  },
  "required": [
    "title",
    "artist"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}