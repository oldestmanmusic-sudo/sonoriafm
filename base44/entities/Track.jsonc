{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "played_at": {
      "type": "string",
      "format": "date-time"
    },
    "genre": {
      "type": "string",
      "description": "G\u00e9nero: los de siempre o uno a\u00f1adido por los artistas.",
      "default": "Otros"
    },
    "duration": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "album": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "language": {
      "type": "string",
      "enum": [
        "Espa\u00f1ol",
        "Otros idiomas"
      ],
      "default": "Espa\u00f1ol",
      "description": "Idioma de la canci\u00f3n"
    }
  },
  "required": [
    "title",
    "artist"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}