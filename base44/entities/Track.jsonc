{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "artist_id": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "played_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "artist"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}