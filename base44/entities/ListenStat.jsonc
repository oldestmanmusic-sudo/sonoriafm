{
  "name": "ListenStat",
  "type": "object",
  "description": "Contador an\u00f3nimo de escucha: un registro por cada minuto que suena la radio en un navegador. Sin usuario, sin IP y sin cookies.",
  "properties": {
    "sid": {
      "type": "string",
      "description": "C\u00f3digo aleatorio de la conexi\u00f3n; vive solo en memoria mientras la web est\u00e1 abierta."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "D\u00eda (hora de Madrid)."
    },
    "mode": {
      "type": "string",
      "enum": [
        "directo",
        "cancion"
      ],
      "default": "directo"
    },
    "zone": {
      "type": "string",
      "description": "Zona de emisi\u00f3n: eu, sa, co o mx."
    },
    "track_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "own": {
      "type": "boolean",
      "default": false,
      "description": "Escucha de un administrador (se excluye de las cifras)."
    }
  },
  "required": [
    "sid",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}