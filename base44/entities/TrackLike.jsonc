{
  "name": "TrackLike",
  "type": "object",
  "properties": {
    "track_id": {
      "type": "string",
      "description": "Id de la canci\u00f3n a la que se dio me gusta."
    },
    "user_id": {
      "type": "string",
      "description": "Id del usuario que dio me gusta, o \"anon:<c\u00f3digo>\" si vot\u00f3 sin cuenta."
    },
    "did": {
      "type": "string",
      "description": "C\u00f3digo aleatorio del dispositivo desde el que se vot\u00f3."
    },
    "anon": {
      "type": "boolean",
      "description": "Verdadero si el voto se hizo sin cuenta."
    },
    "day": {
      "type": "string",
      "description": "D\u00eda del voto (AAAA-MM-DD, hora de Madrid)."
    },
    "net": {
      "type": "string",
      "description": "Resumen cifrado de la conexi\u00f3n, distinto cada d\u00eda; solo para los topes de votos sin cuenta. Nunca la IP."
    }
  },
  "required": [
    "track_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}